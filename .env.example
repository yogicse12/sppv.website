# Resend (https://resend.com) — used to send email from the Contact
# and Book a Consultation forms.
RESEND_API_KEY=

# Must be an address on a domain verified in your Resend account,
# e.g. "SPPV & Co LLP <hello@sppvandco.com>"
EMAIL_FROM=

# Optional — where form submissions are delivered. Defaults to
# sppv2026@outlook.com if not set.
EMAIL_TO=sppv2026@outlook.com
